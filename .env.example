# ── watsonx.ai SaaS (IBM Cloud us-south) ──────────────────────────────────────
# IBM Cloud API key — create at cloud.ibm.com/iam/apikeys
IBM_CLOUD_API_KEY=<your-ibm-cloud-api-key>

# watsonx.ai project ID — visible in Project → Manage → General → Project ID
WX_PROJECT_ID=<your-project-id>

# IAM token endpoint (us-south — do not change)
IAM_URL=https://iam.cloud.ibm.com/identity/token

# watsonx.ai API base URL for us-south
WX_URL=https://us-south.ml.cloud.ibm.com

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal Access Token — github.com → Settings → Developer settings → PAT
# Required scopes: repo (for private) or public_repo (for public)
GITHUB_TOKEN=<your-github-pat>

# Full repo name, e.g. my-org/wxai-git-poc
GITHUB_REPO=<owner>/<repo-name>
